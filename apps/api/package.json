{
  "name": "@pix-live/api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS do Pix Live: webhook Pix assinado, idempotência e conciliação. O domínio puro vem de @pix-live/core.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^6.7.0",
    "@pix-live/core": "workspace:^",
    "@prisma/client": "^6.19.3",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
